# Avloryn Labs — environment variables
# Copy to `.env.local` for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# ALL of these are server-only. Do NOT prefix with NEXT_PUBLIC_ — they must never reach the browser.

# --- Supabase (lead storage) ---
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (notification email) ---
# From resend.com → API Keys
RESEND_API_KEY=

# --- Sanity (blog CMS) ---
# From sanity.io → create a project → Project Settings.
# These two are PUBLIC (used by the read client + the embedded Studio at /studio):
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: pin the API version (defaults to a recent date if unset)
# NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01
# Optional: only needed for private datasets / draft previews (server-only)
# SANITY_API_READ_TOKEN=

# Optional email overrides:
# CONTACT_FROM_EMAIL must use a domain you've verified in Resend.
# Until avloryn.com is verified, the default "onboarding@resend.dev" works
# but can only deliver to the Resend account owner's address.
CONTACT_FROM_EMAIL="Avloryn Labs <onboarding@resend.dev>"
CONTACT_TO_EMAIL=hardev@avloryn.com
